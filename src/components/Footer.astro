        <path d="M178.431 2.82959C160.866 2.82959 147.028 8.36361 136.915 19.4802C126.802 30.5482 121.77 46.0338 121.77 65.8397V100.209C121.77 120.597 126.802 136.229 136.915 147.005C147.028 157.782 160.866 163.171 178.431 163.171C195.995 163.171 209.834 157.782 219.899 147.005C230.012 136.229 235.044 120.597 235.044 100.209V65.8397C235.044 46.0338 230.012 30.5482 219.899 19.4802C209.786 8.41215 195.947 2.82959 178.431 2.82959ZM206.108 101.956C206.108 112.248 204.124 120.597 200.157 127.054C196.189 133.51 188.979 136.763 178.431 136.763C167.882 136.763 160.624 133.559 156.705 127.054C152.737 120.597 150.802 112.248 150.802 101.956V64.0921C150.802 57.6358 151.721 51.762 153.56 46.4707C155.399 41.1794 158.35 37.0046 162.463 33.8978C166.576 30.7909 171.899 29.2861 178.479 29.2861C185.06 29.2861 190.383 30.8395 194.399 33.8978C198.415 37.0046 201.366 41.1794 203.302 46.4707C205.189 51.762 206.157 57.6358 206.157 64.0921V101.956H206.108Z" />
        <path d="M178.407 65.0796C173.304 65.0796 168.894 66.8669 165.128 70.3946C161.362 73.9693 159.528 78.1554 159.528 83C159.528 87.8447 161.411 92.0308 165.128 95.6055C168.894 99.1802 173.304 100.92 178.407 100.92C183.511 100.92 187.921 99.1332 191.687 95.6055C195.453 92.0308 197.286 87.8447 197.286 83C197.286 78.1554 195.403 73.9693 191.687 70.3946C187.921 66.8199 183.511 65.0796 178.407 65.0796Z" />
        <path d="M327.523 8.92677C319.665 4.86198 310.836 2.82959 301.037 2.82959C290.365 2.82959 281.1 5.00715 273.145 9.31389C265.238 13.669 259.077 19.5726 254.76 27.0247C250.394 34.5252 248.26 42.9452 248.26 52.3329V54.8492C248.26 64.3821 250.2 72.7052 254.129 79.9154C258.059 87.1255 263.346 92.6904 269.992 96.7068C276.637 100.675 284.205 102.707 292.597 102.707C300.989 102.707 307.246 101.159 311.758 98.1101C316.269 95.0132 319.471 91.0935 321.459 86.3513H325.243V107.933V134.161L276.589 134.258V108.853H248.308V137.064H273.775V162.227H353.039V134.161V99.0295V51.3651C353.039 41.7354 350.759 33.2671 346.199 25.9602C341.639 18.7016 335.43 13.0399 327.571 8.97516L327.523 8.92677ZM318.258 69.8502C313.649 74.1085 307.731 76.2377 300.601 76.2377C293.47 76.2377 287.552 74.1085 282.943 69.8502C278.335 65.5918 276.007 59.8818 276.007 52.7684C276.007 45.655 278.335 39.945 282.943 35.6866C287.552 31.4283 293.47 29.2991 300.601 29.2991C307.731 29.2991 313.649 31.4283 318.258 35.6866C322.866 39.945 325.195 45.655 325.195 52.7684C325.195 59.8818 322.866 65.5918 318.258 69.8502Z" />
        <path d="M444.343 8.92677C436.414 4.86198 427.506 2.82959 417.619 2.82959C406.851 2.82959 397.502 5.00715 389.475 9.31389C381.497 13.669 375.281 19.5726 370.925 27.0247C366.52 34.5252 364.366 42.9452 364.366 52.3329V54.8492C364.366 64.3821 366.324 72.7052 370.289 79.9154C374.253 87.1255 379.588 92.6904 386.294 96.7068C392.999 100.675 400.635 102.707 409.103 102.707C417.57 102.707 423.884 101.159 428.436 98.1101C432.988 95.0132 436.218 91.0935 438.225 86.3513H442.043V107.933V134.161L392.95 134.258V108.853H364.415V137.064H390.112V162.227H470.089V134.161V99.0295V51.3651C470.089 41.7354 467.789 33.2671 463.188 25.9602C458.587 18.7016 452.322 13.0399 444.392 8.97516L444.343 8.92677ZM434.995 69.8502C430.345 74.1085 424.374 76.2377 417.179 76.2377C409.984 76.2377 404.012 74.1085 399.362 69.8502C394.713 65.5918 392.363 59.8818 392.363 52.7684C392.363 45.655 394.713 39.945 399.362 35.6866C404.012 31.4283 409.984 29.2991 417.179 29.2991C424.374 29.2991 430.345 31.4283 434.995 35.6866C439.645 39.945 441.994 45.655 441.994 52.7684C441.994 59.8818 439.645 65.5918 434.995 69.8502Z" />
        <path d="M500.767 100.92C495.498 100.92 490.948 102.832 487.116 106.657C483.332 110.481 481.416 115.187 481.416 120.727C481.416 126.267 483.332 130.974 487.116 134.798C490.9 138.622 495.45 140.534 500.767 140.534C506.084 140.534 510.586 138.622 514.418 134.798C518.202 130.974 520.118 126.267 520.118 120.727C520.118 115.187 518.202 110.481 514.418 106.657C510.634 102.832 506.084 100.92 500.767 100.92Z" />
        <!-- Header-logo suffix scaled onto the footer wordmark grid -->
        <g transform="matrix(11.1 0 0 11.03 469.7 -297.3)">
          <LogoSuffix />
        </g>
      </svg>
    </a>
  </div>

  <div class="site-footer__bar container">
    <p class="site-footer__copy">© {year} | 2099.studio — {f.rights}</p>
    <button class="site-footer__top" type="button" data-back-to-top>
      <span>{f.backToTop}</span>
      <span aria-hidden="true">↑</span>
    </button>
  </div>
</footer>

<style>
  .site-footer {
    background: transparent;
    border-top: 1px solid var(--color-border);
    padding-top: 64px;
  }

  .site-footer__utility {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr auto;
    gap: var(--gap-layout);
    align-items: start;
    padding-bottom: 48px;
  }

  .site-footer__label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-text-tertiary);
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  .site-footer__email {
    font-family: var(--font-display);
    font-size: var(--text-footer-email);
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-text-primary);
    word-break: break-word;
  }

  .site-footer__email:hover {
    color: var(--color-primary);
  }

  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer__nav a {
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--color-text-secondary);
    text-transform: uppercase;
  }

  .site-footer__nav a:hover {
    color: var(--color-text-primary);
  }

  .site-footer__social {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer__social a {
    display: inline-flex;
    color: var(--color-text-secondary);
    transition: color 0.2s ease;
  }

  .site-footer__social a:hover {
    color: var(--color-primary);
  }

  .site-footer__col--time {
    text-align: right;
  }

  .site-footer__clock {
    font-size: 16px;
    font-weight: 500;
    color: var(--color-text-primary);
    font-variant-numeric: tabular-nums;
  }

  .site-footer__wordmark {
    line-height: 0;
    padding-block: 16px 8px;
  }

  .site-footer__wordmark-svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1280 / 166;
    max-height: clamp(80px, 11.528vw, 166px);
    /* Room for the ".design" g descender (≈25% of the wordmark height) */
    margin-bottom: calc(0.25 * min(12.97%, clamp(80px, 11.528vw, 166px)));
  }

  .site-footer__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 24px 0 max(40px, env(safe-area-inset-bottom));
    border-top: 1px solid var(--color-border);
  }

  .site-footer__copy {
    flex: 1;
    font-size: 11px;
    color: var(--color-text-tertiary);
  }

  .site-footer__top {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: transparent;
    cursor: pointer;
  }

  .site-footer__top:hover {
    color: var(--color-text-primary);
    border-color: var(--color-primary);
  }

  @media (max-width: 900px) {
    .site-footer__utility {
      grid-template-columns: 1fr 1fr;
    }

    .site-footer__col--email {
      grid-column: 1 / -1;
    }

    .site-footer__col--time {
      text-align: left;
    }

    .site-footer__bar {
      flex-direction: column;
      align-items: stretch;
    }

    .site-footer__top {
      justify-content: center;
    }
  }
</style>

<script>
  document.querySelector('[data-back-to-top]')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  const clock = document.querySelector('[data-footer-clock]');
  if (clock) {
    const tick = () => {
      clock.textContent = new Intl.DateTimeFormat(undefined, {
        hour: 'numeric',
        minute: '2-digit',
        timeZone: 'America/Argentina/Buenos_Aires',
      }).format(new Date());
    };
    tick();
    setInterval(tick, 30000);
  }
</script>
