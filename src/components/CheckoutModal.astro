---
import type { SiteContent } from '../i18n/types';

interface Props {
  labels: SiteContent['investment']['checkout'];
}

const { labels } = Astro.props;
---

<div class="checkout" data-checkout hidden data-lenis-prevent>
  <div class="checkout__backdrop" data-checkout-close></div>

  <div class="checkout__panel" role="dialog" aria-modal="true" aria-labelledby="checkout-plan" tabindex="-1">
    <button type="button" class="checkout__close" data-checkout-close aria-label={labels.close}>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
    </button>

    <!-- Order summary -->
    <div class="checkout__summary">
      <p class="checkout__eyebrow">2099.studio · {labels.title}</p>
      <h2 class="checkout__plan" id="checkout-plan" data-checkout-plan></h2>
      <p class="checkout__price" data-checkout-price></p>
      <p class="checkout__ars" data-checkout-ars></p>

      <div class="checkout__lines">
        <p class="checkout__lines-title">{labels.summary}</p>
        <div class="checkout__line">
          <span data-checkout-line-name></span>
          <span data-checkout-line-price></span>
        </div>
        <div class="checkout__line checkout__line--total">
          <span>{labels.total}</span>
          <span data-checkout-total></span>
        </div>
        <p class="checkout__note" data-checkout-note></p>
      </div>
    </div>

    <!-- Payment method -->
    <form class="checkout__pay" data-checkout-form>
      <fieldset class="checkout__methods">
        <legend class="checkout__label">{labels.method}</legend>

        <label class="checkout__option">
          <input type="radio" name="checkout-method" value="mercadopago" />
          <span class="checkout__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <rect x="2.5" y="5" width="19" height="14" rx="2.5" stroke="currentColor" stroke-width="1.6"></rect>
              <path d="M2.5 9.5h19" stroke="currentColor" stroke-width="1.6"></path>
              <path d="M6 15h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
            </svg>
          </span>
          <span class="checkout__option-text">
            <strong>{labels.mercadoPago}</strong>
            <small>{labels.mercadoPagoDetail}</small>
            <span class="checkout__tag" data-checkout-installments data-template={labels.installments} hidden></span>
          </span>
          <span class="checkout__soon" data-checkout-soon="mercadopago" hidden>{labels.soon}</span>
          <span class="checkout__radio" aria-hidden="true"></span>
        </label>

        <label class="checkout__option">
          <input type="radio" name="checkout-method" value="nowpayments" />
          <span class="checkout__icon checkout__icon--ada" aria-hidden="true">₳</span>
          <span class="checkout__option-text">
            <strong>{labels.crypto}</strong>
            <small>{labels.cryptoDetail}</small>
          </span>
          <span class="checkout__soon" data-checkout-soon="nowpayments" hidden>{labels.soon}</span>
          <span class="checkout__radio" aria-hidden="true"></span>
        </label>
      </fieldset>

      <button
        type="submit"
        class="btn-figma-primary checkout__submit"
        data-checkout-submit
        data-label-mercadopago={labels.continueMercadoPago}
        data-label-nowpayments={labels.continueCrypto}
      >
        {labels.continueMercadoPago}
      </button>

      <p class="checkout__secure">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="4" y="10" width="16" height="11" rx="2.5" stroke="currentColor" stroke-width="2"></rect>
          <path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="2"></path>
        </svg>
        {labels.secure}
      </p>
    </form>
  </div>
</div>

<script>
  import { initCheckout } from '../scripts/checkout';
  initCheckout();
</script>

<style>
  .checkout {
    position: fixed;
    inset: 0;
    /* Below the custom cursor layer (2147483647) */
    z-index: 2147483000;
    display: grid;
    place-items: center;
    padding: 16px;
    box-sizing: border-box;
  }

  .checkout[hidden] {
    display: none;
  }

  .checkout__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .checkout__panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    width: min(880px, 100%);
    max-height: calc(100dvh - 32px);
    overflow: auto;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    background: var(--color-surface);
    color: var(--color-text-primary);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
    outline: none;
    opacity: 0;
    transform: translateY(16px) scale(0.98);
    transition:
      opacity 0.25s ease,
      transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .checkout.is-open .checkout__backdrop,
  .checkout.is-open .checkout__panel {
    opacity: 1;
  }

  .checkout.is-open .checkout__panel {
    transform: none;
  }

  .checkout__close {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-text-primary);
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .checkout__close:hover {
    border-color: var(--color-primary);
  }

  .checkout__close:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* ── Summary ── */
  .checkout__summary {
    display: flex;
    flex-direction: column;
    padding: 40px;
    background: var(--color-elevated);
    border-right: 1px solid var(--color-border);
  }

  .checkout__eyebrow {
    margin: 0 0 28px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .checkout__plan {
    margin: 0 0 8px;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .checkout__price {
    margin: 0;
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.5px;
  }

  .checkout__ars {
    margin: 6px 0 0;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--color-text-secondary);
  }

  .checkout__lines {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: auto;
    padding-top: 36px;
    font-family: var(--font-body);
    font-size: 14px;
  }

  .checkout__lines-title {
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .checkout__line {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  .checkout__line--total {
    padding-top: 12px;
    border-top: 1px solid var(--color-border);
    font-weight: 700;
  }

  .checkout__note {
    margin: 0;
    font-size: 13px;
    line-height: 1.4;
    color: var(--color-text-secondary);
  }

  /* ── Payment ── */
  .checkout__pay {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 0;
    padding: 40px;
    padding-top: 72px;
  }

  .checkout__methods {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .checkout__label {
    margin-bottom: 6px;
    padding: 0;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .checkout__option {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-surface);
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
  }

  .checkout__option:hover {
    border-color: var(--color-border-strong);
  }

  .checkout__option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .checkout__option:has(input:checked) {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 1px var(--color-primary);
    background: var(--color-accent-blue-glow);
  }

  .checkout__option:has(input:focus-visible) {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .checkout__option:has(input:disabled) {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .checkout__icon {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-elevated);
    color: var(--color-text-primary);
  }

  .checkout__icon--ada {
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 600;
  }

  .checkout__option-text {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    font-family: var(--font-body);
  }

  .checkout__option-text strong {
    font-size: 15px;
    font-weight: 600;
  }

  .checkout__option-text small {
    font-size: 12.5px;
    line-height: 1.35;
    color: var(--color-text-secondary);
  }

  .checkout__tag {
    align-self: flex-start;
    margin-top: 4px;
    padding: 3px 8px;
    border-radius: 999px;
    background: var(--color-accent-blue-glow);
    color: var(--color-primary);
    font-size: 11.5px;
    font-weight: 600;
    line-height: 1.3;
  }

  .checkout__tag[hidden] {
    display: none;
  }

  .checkout__soon {
    flex-shrink: 0;
    padding: 4px 8px;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .checkout__soon[hidden] {
    display: none;
  }

  .checkout__radio {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    border: 1.5px solid var(--color-border-strong);
    border-radius: 50%;
    box-sizing: border-box;
    transition:
      border-color 0.2s ease,
      border-width 0.2s ease;
  }

  .checkout__option:has(input:checked) .checkout__radio {
    border-color: var(--color-primary);
    border-width: 5px;
  }

  .checkout__submit {
    width: 100%;
    padding: 16px 24px;
    font-size: 15px;
    cursor: pointer;
  }

  .checkout__submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .checkout__secure {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin: -6px 0 0;
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--color-text-secondary);
  }

  /* Mobile: bottom sheet */
  @media (max-width: 720px) {
    .checkout {
      place-items: end stretch;
      padding: 0;
    }

    .checkout__panel {
      grid-template-columns: 1fr;
      width: 100%;
      max-height: 92dvh;
      border-radius: 20px 20px 0 0;
      border-bottom: 0;
      transform: translateY(40px);
    }

    .checkout__summary {
      padding: 28px 20px 20px;
      border-right: 0;
      border-bottom: 1px solid var(--color-border);
    }

    .checkout__eyebrow {
      margin-bottom: 16px;
    }

    .checkout__price {
      font-size: 32px;
    }

    .checkout__lines {
      padding-top: 20px;
    }

    .checkout__pay {
      padding: 20px 20px calc(20px + env(safe-area-inset-bottom));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .checkout__backdrop,
    .checkout__panel {
      transition: none;
    }
  }
</style>
