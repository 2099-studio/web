---
import type { Locale } from '../i18n';
import { getContent } from '../i18n';
import CanvasText from './CanvasText.astro';
import SparklesText from './SparklesText.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
const chat = t.heroChat;

const highlight = t.hero.titleHighlight?.trim() || '';
const titleLines = t.hero.title.split('\n').map((line) => line.trim()).filter(Boolean);

const leadLines = [t.hero.lead, t.hero.leadSecondary].filter(
  (line): line is string => Boolean(line?.trim()),
);

function splitHighlight(line: string) {
  if (!highlight) return { before: line, match: '', after: '' };
  const index = line.lastIndexOf(highlight);
  if (index < 0) return { before: line, match: '', after: '' };
  return {
    before: line.slice(0, index),
    match: highlight,
    after: line.slice(index + highlight.length),
  };
}
---

<section class="hero" id="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero__shell container" data-reveal>
    <div class="hero__copy" data-hero-title>
      <h1 class="hero__title" id="hero-title">
        {
          titleLines.map((line) => {
            const { before, match, after } = splitHighlight(line);
            return (
              <span class="hero__title-line">
                {before}
                {match ? (
                  <SparklesText class="hero__title-sparkles">
                    <CanvasText text={match} class="hero__title-canvas" />
                  </SparklesText>
                ) : null}
                {after}
              </span>
            );
          })
        }
      </h1>
      <p class="hero__lead" data-hero-content>
        {leadLines.map((line) => (
          <span class="hero__lead-line">{line}</span>
        ))}
      </p>
    </div>

    <div class="hero__divider" aria-hidden="true"></div>

    <div class="hero-chat" data-hero-chat>
      <div
        class="hero-chat__thread"
        data-hero-chat-messages
        role="log"
        aria-live="polite"
        aria-relevant="additions"
      ></div>

      <form class="hero-chat__panel" data-hero-chat-form>
        <p class="hero-chat__prompt" data-hero-chat-prompt>
          <span class="hero-chat__prompt-label">{chat.assistantLabel}</span>{' '}
          <span data-hero-chat-prompt-text>{chat.initialMessage}</span>
        </p>

        <textarea
          class="hero-chat__input"
          name="message"
          data-hero-chat-input
          rows="1"
          placeholder={chat.inputPlaceholder}
          autocomplete="off"
          required
        ></textarea>

        <div class="hero-chat__footer">
          <div class="hero-chat__suggestions" data-hero-chat-suggestions hidden>
            <div class="hero-chat__suggestions-list"></div>
          </div>

          <button class="hero-chat__send btn-figma-primary" type="submit" aria-label={chat.sendAria}>
            {chat.sendLabel}
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100svh;
    padding: calc(var(--header-height) + clamp(20px, 4vh, 40px)) 0 clamp(24px, 4vh, 48px);
    overflow-x: clip;
    background: transparent;
    --hero-shell-w: clamp(320px, min(92vw, 960px), 960px);
  }

  .hero__shell {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 3vh, 32px);
    width: var(--hero-shell-w);
    max-width: calc(100% - var(--margin) * 2);
    margin-inline: auto;
    padding: clamp(24px, 4vw, 40px);
    border: 1px solid color-mix(in srgb, var(--color-border) 85%, transparent);
    border-radius: clamp(20px, 2.5vw, 28px);
    background: color-mix(in srgb, var(--color-surface) 90%, transparent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-border) 30%, transparent);
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(12px, 2vh, 16px);
  }

  .hero__title {
    margin: 0;
    width: fit-content;
    max-width: 100%;
    font-family: var(--font-display);
    font-size: var(--text-hero);
    font-weight: 700;
    line-height: 0.95;
    color: var(--color-text-primary);
  }

  .hero__title-line {
    display: block;
    white-space: nowrap;
  }

  .hero__title :global(.sparkles-text),
  .hero__title :global(.canvas-text) {
    vertical-align: baseline;
  }

  .hero__lead {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin: 0;
    max-width: min(100%, 640px);
    font-family: var(--font-body);
    font-size: var(--text-hero-lead);
    line-height: 1.6;
    color: #d9d9d9;
  }

  .hero__lead-line {
    display: block;
  }

  :global([data-theme='light']) .hero__lead {
    color: var(--color-text-secondary);
  }

  .hero__divider {
    height: 1px;
    border: 0;
    background: repeating-linear-gradient(
      to right,
      color-mix(in srgb, var(--color-border) 70%, transparent) 0 6px,
      transparent 6px 14px
    );
    opacity: 0.9;
  }

  .hero-chat {
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 2vh, 16px);
    width: 100%;
  }

  .hero-chat__thread {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-height: min(22vh, 200px);
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .hero-chat__thread:empty {
    display: none;
  }

  .hero-chat__msg {
    max-width: 88%;
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.5;
  }

  .hero-chat__msg p {
    margin: 0;
  }

  .hero-chat__msg--user {
    align-self: flex-end;
    padding: 8px 14px;
    border-radius: 16px;
    color: var(--color-text-primary);
    background: color-mix(in srgb, var(--color-border) 50%, var(--color-surface));
    border: 1px solid color-mix(in srgb, var(--color-border) 75%, transparent);
  }

  .hero-chat__panel {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: clamp(140px, 22vw, 180px);
    padding: clamp(14px, 2vw, 18px);
    border: 1px solid color-mix(in srgb, var(--color-border) 80%, transparent);
    border-radius: clamp(16px, 2vw, 22px);
    background: color-mix(in srgb, var(--color-bg) 40%, var(--color-surface));
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .hero-chat__panel:focus-within {
    border-color: color-mix(in srgb, var(--color-primary) 40%, var(--color-border));
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-primary) 20%, transparent);
  }

  .hero-chat__prompt {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(14px, 1.1vw, 15px);
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  .hero-chat__prompt-label {
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .hero-chat__input {
    width: 100%;
    min-height: 28px;
    max-height: min(100px, 16vh);
    resize: none;
    border: 0;
    background: transparent;
    color: var(--color-text-primary);
    font-family: var(--font-body);
    font-size: clamp(14px, 1.1vw, 16px);
    line-height: 1.5;
    outline: none;
    field-sizing: content;
  }

  .hero-chat__input::placeholder {
    color: var(--color-text-tertiary);
  }

  .hero-chat__input:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .hero-chat__footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
  }

  .hero-chat__suggestions {
    flex: 1 1 auto;
    min-width: 0;
  }

  .hero-chat__suggestions-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .hero-chat__chip {
    padding: 6px 12px;
    border: 1px solid color-mix(in srgb, var(--color-border) 85%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-border) 22%, transparent);
    color: var(--color-text-secondary);
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 1.3;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      background 0.2s ease;
  }

  .hero-chat__chip:hover {
    border-color: color-mix(in srgb, var(--color-primary) 45%, var(--color-border));
    color: var(--color-text-primary);
    background: color-mix(in srgb, var(--color-primary) 8%, transparent);
  }

  .hero-chat__send {
    flex: 0 0 auto;
    min-width: 88px;
    height: 40px;
    padding: 0 20px;
    border: 0;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    cursor: pointer;
    text-transform: none;
  }

  .hero-chat__send:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  @supports not (field-sizing: content) {
    .hero-chat__input {
      min-height: 44px;
    }
  }

  @media (max-width: 1023px) {
    .hero__title-line,
    .hero__lead-line {
      white-space: normal;
      text-wrap: balance;
    }

    .hero__copy {
      align-items: flex-start;
      text-align: left;
    }

    .hero__title {
      width: 100%;
      line-height: 1.05;
    }

    .hero__lead {
      align-items: flex-start;
    }
  }

  @media (max-width: 767px) {
    .hero {
      min-height: 0;
      align-items: stretch;
    }

    .hero__shell {
      padding: 20px 16px;
    }

    .hero__title {
      font-size: clamp(1.75rem, 8.5vw, 2.5rem);
    }

    .hero__lead {
      font-size: clamp(0.9375rem, 3.8vw, 1.125rem);
    }

    .hero-chat__chip {
      white-space: normal;
      text-align: left;
    }

    .hero-chat__send {
      min-width: 76px;
    }
  }
</style>
