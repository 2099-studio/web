---
import type { Locale } from '../i18n';
import { getContent } from '../i18n';
import CanvasText from './CanvasText.astro';
import SparklesText from './SparklesText.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
const chat = t.heroChat;

const highlight = t.hero.titleHighlight?.trim() || '';
const titleLines = t.hero.title.split('\n').map((line) => line.trim()).filter(Boolean);

const leadLines = [t.hero.lead, t.hero.leadSecondary].filter(
  (line): line is string => Boolean(line?.trim()),
);

function splitHighlight(line: string) {
  if (!highlight) return { before: line, match: '', after: '' };
  const index = line.lastIndexOf(highlight);
  if (index < 0) return { before: line, match: '', after: '' };
  return {
    before: line.slice(0, index),
    match: highlight,
    after: line.slice(index + highlight.length),
  };
}
---

<section class="hero" id="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero__inner container">
    <p class="hero__eyebrow" data-hero-content>{t.hero.eyebrow}</p>

    <div class="hero__copy" data-hero-title>
      <h1 class="hero__title" id="hero-title">
        {
          titleLines.map((line) => {
            const { before, match, after } = splitHighlight(line);
            return (
              <span class="hero__title-line">
                {before}
                {match ? (
                  <SparklesText class="hero__title-sparkles">
                    <CanvasText text={match} class="hero__title-canvas" />
                  </SparklesText>
                ) : null}
                {after}
              </span>
            );
          })
        }
      </h1>
      <p class="hero__lead" data-hero-content>
        {leadLines.map((line) => (
          <span class="hero__lead-line">{line}</span>
        ))}
      </p>
    </div>

    <div class="hero__actions" data-hero-content>
      <a class="btn-figma-primary" href="#diagnostic">{t.hero.ctaWorks}</a>
      <a class="btn-figma-secondary" href="#investment">{t.hero.ctaContact}</a>
    </div>
  </div>

  <div class="hero__chat-wrap container" data-reveal>
    <div class="hero-chat" data-hero-chat>
      <div class="hero-chat__messages" data-hero-chat-messages role="log" aria-live="polite" aria-relevant="additions">
        <div class="hero-chat__msg hero-chat__msg--assistant">
          <p>{chat.initialMessage}</p>
        </div>
      </div>

      <div class="hero-chat__composer">
        <div class="hero-chat__suggestions" data-hero-chat-suggestions hidden>
          <span class="hero-chat__suggestions-label">{chat.suggestionsLabel}</span>
        </div>

        <form class="hero-chat__form" data-hero-chat-form>
          <input
            class="hero-chat__input"
            type="text"
            name="message"
            data-hero-chat-input
            placeholder={chat.inputPlaceholder}
            autocomplete="off"
            required
          />
          <button class="hero-chat__send" type="submit" aria-label={chat.sendAria}>→</button>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    gap: 56px;
    min-height: 100svh;
    padding-top: calc(var(--header-height) + 26px);
    padding-bottom: 24px;
    overflow-x: clip;
    overflow-y: visible;
    background: transparent;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: min(100% - var(--margin) * 2, var(--hero-copy-max));
    margin-inline: auto;
    gap: 0;
    flex: 1 1 auto;
    justify-content: center;
  }

  .hero__eyebrow {
    margin: 0 0 14px;
    padding: 8px 16px;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0;
    line-height: normal;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .hero__copy {
    width: 100%;
  }

  .hero__title {
    margin: 0 auto 16px;
    width: fit-content;
    max-width: 100%;
    font-family: var(--font-display);
    font-size: var(--text-hero);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: 0;
    color: var(--color-text-primary);
    white-space: normal;
    text-wrap: unset;
  }

  .hero__title-line {
    display: block;
    white-space: nowrap;
  }

  .hero__title :global(.sparkles-text),
  .hero__title :global(.canvas-text) {
    vertical-align: baseline;
  }

  .hero__title :global(.canvas-text__label) {
    font-weight: inherit;
  }

  .hero__lead {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    margin: 0 auto 16px;
    max-width: min(100%, var(--hero-copy-max));
    font-family: var(--font-body);
    font-size: var(--text-hero-lead);
    font-weight: 400;
    line-height: 1.7;
    letter-spacing: 0;
    color: #d9d9d9;
  }

  .hero__lead-line {
    display: block;
    white-space: nowrap;
  }

  :global([data-theme='light']) .hero__lead {
    color: var(--color-text-secondary);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-bottom: 0;
  }

  .hero__actions :global(.btn-figma-primary),
  .hero__actions :global(.btn-figma-secondary) {
    min-width: 91px;
    padding: var(--hero-btn-py) var(--hero-btn-px);
    font-family: var(--font-body);
    font-size: var(--text-hero-btn);
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    line-height: normal;
  }

  .hero__chat-wrap {
    flex: 0 0 auto;
    width: min(100% - var(--margin) * 2, 720px);
    margin-inline: auto;
    margin-top: clamp(8px, 2vh, 24px);
  }

  .hero-chat {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 320px;
    max-height: min(420px, 42vh);
    padding: 20px;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: color-mix(in srgb, var(--color-surface) 88%, transparent);
    backdrop-filter: blur(8px);
  }

  .hero-chat__messages {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 0;
    overflow-y: auto;
    padding-right: 4px;
    scrollbar-width: thin;
  }

  .hero-chat__msg {
    max-width: 88%;
    padding: 12px 16px;
    border-radius: 14px;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.5;
  }

  .hero-chat__msg p {
    margin: 0;
  }

  .hero-chat__msg--assistant {
    align-self: flex-start;
    color: var(--color-text-primary);
    background: color-mix(in srgb, var(--color-border) 35%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
  }

  .hero-chat__msg--user {
    align-self: flex-end;
    color: var(--color-text-primary);
    background: color-mix(in srgb, var(--color-primary) 14%, var(--color-surface));
    border: 1px solid color-mix(in srgb, var(--color-primary) 28%, var(--color-border));
  }

  .hero-chat__composer {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .hero-chat__suggestions {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .hero-chat__suggestions-label {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .hero-chat__suggestions-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .hero-chat__chip {
    padding: 6px 12px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: transparent;
    color: var(--color-text-secondary);
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 1.35;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      background 0.2s ease;
  }

  .hero-chat__chip:hover {
    border-color: color-mix(in srgb, var(--color-primary) 40%, var(--color-border));
    color: var(--color-text-primary);
    background: color-mix(in srgb, var(--color-primary) 8%, transparent);
  }

  .hero-chat__form {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 6px 6px 16px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
  }

  .hero-chat__input {
    flex: 1 1 auto;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--color-text-primary);
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.4;
    outline: none;
  }

  .hero-chat__input::placeholder {
    color: var(--color-text-tertiary);
  }

  .hero-chat__input:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .hero-chat__send {
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-bg, #080808);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .hero-chat__send:hover:not(:disabled) {
    opacity: 0.88;
  }

  .hero-chat__send:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  @media (max-width: 1023px) {
    .hero__title {
      width: 100%;
      max-width: none;
      line-height: 1.05;
    }

    .hero__title-line,
    .hero__lead-line {
      white-space: normal;
      overflow: visible;
      text-overflow: unset;
      text-wrap: balance;
    }

    .hero__lead {
      align-items: flex-start;
      width: 100%;
      max-width: none;
    }

    .hero__eyebrow {
      white-space: normal;
      text-wrap: balance;
      line-height: 1.35;
    }
  }

  @media (max-height: 800px) and (min-width: 768px) {
    .hero {
      min-height: 0;
      gap: 24px;
      padding-bottom: 16px;
    }

    .hero-chat {
      min-height: 280px;
      max-height: 36vh;
    }
  }

  @media (max-width: 767px) {
    .hero {
      min-height: 0;
      padding-bottom: 32px;
      gap: 32px;
    }

    .hero__inner {
      align-items: stretch;
      text-align: left;
      width: min(100% - var(--margin) * 2, var(--hero-copy-max));
      flex: 0 1 auto;
      justify-content: flex-start;
    }

    .hero__title {
      margin-inline: 0;
      font-size: clamp(1.75rem, 8.5vw, 2.5rem);
    }

    .hero__lead {
      margin-inline: 0;
      font-size: clamp(0.9375rem, 3.8vw, 1.125rem);
      line-height: 1.45;
    }

    .hero__actions {
      flex-direction: column;
      align-items: stretch;
      margin-bottom: 8px;
    }

    .hero__actions :global(.btn-figma-primary),
    .hero__actions :global(.btn-figma-secondary) {
      width: 100%;
    }

    .hero__chat-wrap {
      width: min(100% - var(--margin) * 2, 100%);
    }

    .hero-chat {
      min-height: 300px;
      max-height: none;
      padding: 16px;
    }

    .hero-chat__msg {
      max-width: 94%;
      font-size: 14px;
    }
  }
</style>
