---
import type { Locale } from '../i18n';
import { getContent } from '../i18n';
import CanvasText from './CanvasText.astro';
import SparklesText from './SparklesText.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
const chat = t.heroChat;

const highlight = t.hero.titleHighlight?.trim() || '';
const titleLines = t.hero.title.split('\n').map((line) => line.trim()).filter(Boolean);

const leadLines = [t.hero.lead, t.hero.leadSecondary].filter(
  (line): line is string => Boolean(line?.trim()),
);

function splitHighlight(line: string) {
  if (!highlight) return { before: line, match: '', after: '' };
  const index = line.lastIndexOf(highlight);
  if (index < 0) return { before: line, match: '', after: '' };
  return {
    before: line.slice(0, index),
    match: highlight,
    after: line.slice(index + highlight.length),
  };
}
---

<section class="hero" id="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero__inner container">
    <p class="hero__eyebrow" data-hero-content>{t.hero.eyebrow}</p>

    <div class="hero__copy" data-hero-title>
      <h1 class="hero__title" id="hero-title">
        {
          titleLines.map((line) => {
            const { before, match, after } = splitHighlight(line);
            return (
              <span class="hero__title-line">
                {before}
                {match ? (
                  <SparklesText class="hero__title-sparkles">
                    <CanvasText text={match} class="hero__title-canvas" />
                  </SparklesText>
                ) : null}
                {after}
              </span>
            );
          })
        }
      </h1>
      <p class="hero__lead" data-hero-content>
        {leadLines.map((line) => (
          <span class="hero__lead-line">{line}</span>
        ))}
      </p>
    </div>

    <div class="hero__actions" data-hero-content>
      <a class="btn-figma-primary" href="#diagnostic">{t.hero.ctaWorks}</a>
      <a class="btn-figma-secondary" href="#investment">{t.hero.ctaContact}</a>
    </div>
  </div>

  <div class="hero__chat-wrap" data-reveal>
    <div class="hero-chat" data-hero-chat>
      <div
        class="hero-chat__thread"
        data-hero-chat-messages
        role="log"
        aria-live="polite"
        aria-relevant="additions"
      >
        <div class="hero-chat__msg hero-chat__msg--assistant">
          <p>{chat.initialMessage}</p>
        </div>
      </div>

      <form class="hero-chat__panel" data-hero-chat-form>
        <textarea
          class="hero-chat__input"
          name="message"
          data-hero-chat-input
          rows="1"
          placeholder={chat.panelPlaceholder}
          autocomplete="off"
          required
        ></textarea>

        <div class="hero-chat__footer">
          <div class="hero-chat__suggestions" data-hero-chat-suggestions hidden>
            <div class="hero-chat__suggestions-list"></div>
          </div>

          <button class="hero-chat__send" type="submit" aria-label={chat.sendAria}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M12 5v14M6 11l6-6 6 6"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    gap: 56px;
    min-height: 100svh;
    padding-top: calc(var(--header-height) + 26px);
    padding-bottom: 24px;
    overflow-x: clip;
    overflow-y: visible;
    background: transparent;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: min(100% - var(--margin) * 2, var(--hero-copy-max));
    margin-inline: auto;
    gap: 0;
    flex: 1 1 auto;
    justify-content: center;
  }

  .hero__eyebrow {
    margin: 0 0 14px;
    padding: 8px 16px;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0;
    line-height: normal;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .hero__copy {
    width: 100%;
  }

  .hero__title {
    margin: 0 auto 16px;
    width: fit-content;
    max-width: 100%;
    font-family: var(--font-display);
    font-size: var(--text-hero);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: 0;
    color: var(--color-text-primary);
    white-space: normal;
    text-wrap: unset;
  }

  .hero__title-line {
    display: block;
    white-space: nowrap;
  }

  .hero__title :global(.sparkles-text),
  .hero__title :global(.canvas-text) {
    vertical-align: baseline;
  }

  .hero__title :global(.canvas-text__label) {
    font-weight: inherit;
  }

  .hero__lead {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    margin: 0 auto 16px;
    max-width: min(100%, var(--hero-copy-max));
    font-family: var(--font-body);
    font-size: var(--text-hero-lead);
    font-weight: 400;
    line-height: 1.7;
    letter-spacing: 0;
    color: #d9d9d9;
  }

  .hero__lead-line {
    display: block;
    white-space: nowrap;
  }

  :global([data-theme='light']) .hero__lead {
    color: var(--color-text-secondary);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-bottom: 0;
  }

  .hero__actions :global(.btn-figma-primary),
  .hero__actions :global(.btn-figma-secondary) {
    min-width: 91px;
    padding: var(--hero-btn-py) var(--hero-btn-px);
    font-family: var(--font-body);
    font-size: var(--text-hero-btn);
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    line-height: normal;
  }

  .hero__chat-wrap {
    flex: 0 0 auto;
    width: min(100% - var(--margin) * 2, 900px);
    margin-inline: auto;
    margin-top: clamp(16px, 3vh, 40px);
  }

  .hero-chat {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hero-chat__thread {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-height: min(220px, 28vh);
    overflow-y: auto;
    padding-inline: 4px;
    scrollbar-width: thin;
  }

  .hero-chat__msg {
    max-width: 85%;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.55;
  }

  .hero-chat__msg p {
    margin: 0;
  }

  .hero-chat__msg--assistant {
    align-self: flex-start;
    color: var(--color-text-secondary);
  }

  .hero-chat__msg--user {
    align-self: flex-end;
    padding: 10px 16px;
    border-radius: 20px;
    color: var(--color-text-primary);
    background: color-mix(in srgb, var(--color-border) 55%, var(--color-surface));
    border: 1px solid color-mix(in srgb, var(--color-border) 80%, transparent);
  }

  :global([data-theme='light']) .hero-chat__msg--user {
    background: color-mix(in srgb, var(--color-border) 40%, var(--color-surface));
  }

  .hero-chat__panel {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 132px;
    padding: 18px 20px 16px;
    border: 1px solid color-mix(in srgb, var(--color-border) 90%, transparent);
    border-radius: 24px;
    background: color-mix(in srgb, var(--color-surface) 92%, #000);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-border) 35%, transparent);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .hero-chat__panel:focus-within {
    border-color: color-mix(in srgb, var(--color-primary) 45%, var(--color-border));
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-primary) 25%, transparent);
  }

  .hero-chat__input {
    width: 100%;
    min-height: 28px;
    max-height: 120px;
    resize: none;
    border: 0;
    background: transparent;
    color: var(--color-text-primary);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.5;
    outline: none;
    field-sizing: content;
  }

  .hero-chat__input::placeholder {
    color: var(--color-text-tertiary);
  }

  .hero-chat__input:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .hero-chat__footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
  }

  .hero-chat__suggestions {
    flex: 1 1 auto;
    min-width: 0;
  }

  .hero-chat__suggestions-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .hero-chat__chip {
    padding: 7px 14px;
    border: 1px solid color-mix(in srgb, var(--color-border) 85%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-border) 25%, transparent);
    color: var(--color-text-secondary);
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 1.3;
    cursor: pointer;
    white-space: nowrap;
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      background 0.2s ease;
  }

  .hero-chat__chip:hover {
    border-color: color-mix(in srgb, var(--color-primary) 50%, var(--color-border));
    color: var(--color-text-primary);
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
  }

  .hero-chat__send {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: var(--color-primary);
    color: #fff;
    cursor: pointer;
    transition:
      opacity 0.2s ease,
      transform 0.15s ease;
  }

  .hero-chat__send:hover:not(:disabled) {
    opacity: 0.92;
    transform: translateY(-1px);
  }

  .hero-chat__send:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  @supports not (field-sizing: content) {
    .hero-chat__input {
      min-height: 48px;
    }
  }

  @media (max-width: 1023px) {
    .hero__title {
      width: 100%;
      max-width: none;
      line-height: 1.05;
    }

    .hero__title-line,
    .hero__lead-line {
      white-space: normal;
      overflow: visible;
      text-overflow: unset;
      text-wrap: balance;
    }

    .hero__lead {
      align-items: flex-start;
      width: 100%;
      max-width: none;
    }

    .hero__eyebrow {
      white-space: normal;
      text-wrap: balance;
      line-height: 1.35;
    }
  }

  @media (max-height: 800px) and (min-width: 768px) {
    .hero {
      min-height: 0;
      gap: 24px;
      padding-bottom: 16px;
    }

    .hero-chat__thread {
      max-height: 160px;
    }

    .hero-chat__panel {
      min-height: 120px;
    }
  }

  @media (max-width: 767px) {
    .hero {
      min-height: 0;
      padding-bottom: 32px;
      gap: 32px;
    }

    .hero__inner {
      align-items: stretch;
      text-align: left;
      width: min(100% - var(--margin) * 2, var(--hero-copy-max));
      flex: 0 1 auto;
      justify-content: flex-start;
    }

    .hero__title {
      margin-inline: 0;
      font-size: clamp(1.75rem, 8.5vw, 2.5rem);
    }

    .hero__lead {
      margin-inline: 0;
      font-size: clamp(0.9375rem, 3.8vw, 1.125rem);
      line-height: 1.45;
    }

    .hero__actions {
      flex-direction: column;
      align-items: stretch;
      margin-bottom: 8px;
    }

    .hero__actions :global(.btn-figma-primary),
    .hero__actions :global(.btn-figma-secondary) {
      width: 100%;
    }

    .hero__chat-wrap {
      width: min(100% - var(--margin) * 2, 100%);
    }

    .hero-chat__panel {
      min-height: 120px;
      padding: 14px 16px 12px;
      border-radius: 20px;
    }

    .hero-chat__input {
      font-size: 15px;
    }

    .hero-chat__chip {
      font-size: 11px;
      padding: 6px 12px;
      white-space: normal;
      text-align: left;
    }

    .hero-chat__msg {
      max-width: 92%;
      font-size: 14px;
    }
  }
</style>
