---
import type { Locale } from '../i18n';
import { getContent } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
const { diagnostic: d } = t;
---

<section class="diagnostic figma-section" id="diagnostic" aria-labelledby="diagnostic-title">
  <div class="diagnostic__wrap container">
    <header class="figma-section__head" data-reveal>
      <span class="figma-badge">{d.badge}</span>
      <h2 class="figma-section__title" id="diagnostic-title" data-text-reveal>{d.title}</h2>
      <p class="figma-section__subtitle diagnostic__lead" data-text-reveal>{d.lead}</p>
    </header>

    <div class="diagnostic__body" data-reveal>
      <p class="diagnostic__label">{d.opportunitiesLabel}</p>
      <ul class="diagnostic__list">
        {
          d.opportunities.map((item, index) => (
            <li class="diagnostic__item">
              <span class="diagnostic__index">{String(index + 1).padStart(2, '0')}</span>
              <p class="diagnostic__text">{item}</p>
              <a class="diagnostic__plan-link" href={d.planLinks[index]?.href || '#investment'}>
                {d.planLinks[index]?.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a class="btn-figma-primary diagnostic__cta" href="#contact">{d.cta}</a>
    </div>
  </div>
</section>

<style>
  .diagnostic.figma-section {
    padding-block: var(--section-padding-y);
  }

  .diagnostic__lead {
    max-width: 720px;
  }

  .diagnostic__body {
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin-top: 8px;
  }

  .diagnostic__label {
    margin: 0;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .diagnostic__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .diagnostic__item {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-surface);
  }

  .diagnostic__index {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    color: var(--color-accent-orange);
  }

  .diagnostic__text {
    margin: 0;
    flex: 1;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  .diagnostic__plan-link {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .diagnostic__plan-link:hover {
    text-decoration: underline;
  }

  .diagnostic__cta {
    align-self: flex-start;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .diagnostic__list {
      grid-template-columns: 1fr;
    }
  }
</style>
