---
import type { Locale } from '../i18n';
import { getContent } from '../i18n';
import { withBase } from '../utils/paths';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
const baseUrl = import.meta.env.BASE_URL;
const folderImages = [
  'service-folder-branding.jpg',
  'service-folder-uxui.jpg',
  'service-folder-advertising.jpg',
  'service-folder-development.jpg',
];

const UNION_PATH =
  'M129.876 0C135.501 0 140.714 2.95353 143.604 7.7793L155.043 26.8828C157.933 31.7086 163.146 34.6621 168.771 34.6621H298C306.837 34.6621 314 41.8256 314 50.6621V372.422C314 381.258 306.837 388.422 298 388.422H16C7.16344 388.422 0 381.258 0 372.422V16C0 7.16345 7.16345 0 16 0H129.876Z';
---

<section class="services-pin figma-section" id="servicios" data-services-pin aria-labelledby="services-title">
  <div class="services-pin__sticky" data-services-sticky>
    <div class="services-pin__fit">
      <header class="services-pin__head" data-reveal>
        <span class="figma-badge">{t.services.badge}</span>
        <h2 class="services-pin__title" id="services-title" data-text-reveal>{t.services.title}</h2>
      </header>

      <div class="services-pin__stage" data-services-stage data-reveal>
      {
        t.services.items.map((service, index) => (
          <article
            class={`services-pin__panel${index === 0 ? ' is-active' : ''}`}
            data-services-panel
            data-index={index}
            aria-hidden={index !== 0}
          >
            <div class="services-pin__intro">
              <span class="services-pin__num" aria-hidden="true">{service.number}</span>
              <div class="services-pin__copy">
                <h3>{service.shortTitle ?? service.title}</h3>
                <p>{service.description}</p>
              </div>
            </div>

            <div class="services-pin__visual">
              <div class="services-pin__media">
                <img
                  src={withBase(`assets/brand/${folderImages[index % folderImages.length]}`, baseUrl)}
                  alt=""
                  width="243"
                  height="333"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </div>
              <div class="services-pin__folder" aria-hidden="true">
                <svg
                  class="services-pin__folder-shape"
                  viewBox="0 0 314 388.422"
                  preserveAspectRatio="none"
                  width="314"
                  height="388"
                  focusable="false"
                >
                  <path
                    class="services-pin__folder-fill"
                    d={UNION_PATH}
                    vector-effect="non-scaling-stroke"
                  ></path>
                </svg>
                <ul class="services-pin__list">
                  {service.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="services-pin__progress" data-reveal aria-hidden="true">
      {
        t.services.items.map((item, index) => (
          <button
            type="button"
            class={`services-pin__tick${index === 0 ? ' is-active' : ''}`}
            data-services-tick
            aria-label={item.shortTitle ?? item.title}
          ></button>
        ))
      }
    </div>
    </div>
  </div>
</section>

<style>
  /* Figma 1FNfMUp — Branding component 11:77 (1082×438) applied to all services */
  .services-pin {
    position: relative;
    padding-block: 0;
    background: transparent;
  }

  .services-pin__sticky {
    position: relative;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: stretch;
    box-sizing: border-box;
    overflow: hidden;
  }

  .services-pin__fit {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(28px, 4vw, 48px);
    padding-block: clamp(72px, 8vw, 120px);
    width: 100%;
  }

  .services-pin__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
    padding-inline: var(--margin);
  }

  .services-pin__title {
    margin: 0;
    max-width: 28ch;
    font-family: var(--font-display);
    font-size: var(--text-section-title);
    font-weight: 700;
    letter-spacing: -0.84px;
    line-height: normal;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .services-pin__stage {
    position: relative;
    width: min(1082px, calc(100% - var(--margin) * 2));
    margin-inline: auto;
    /* Figma 11:77 frame height */
    min-height: 438.422px;
    overflow: visible;
  }

  .services-pin__panel {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: max-content var(--service-visual-w);
    column-gap: var(--service-visual-gap);
    align-items: start;
    justify-content: start;
    opacity: 0;
    visibility: hidden;
    transform: translateY(36px);
    transition:
      opacity 0.55s ease,
      transform 0.65s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0.55s;
    pointer-events: none;
  }

  .services-pin__panel.is-active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
    z-index: 2;
  }

  /* Number auto-width + 32px gap to copy (Figma: 01=135px, intro x=167) */
  .services-pin__intro {
    display: grid;
    grid-template-columns: max-content var(--service-copy-w);
    column-gap: var(--service-num-to-copy-gap);
    align-items: start;
    width: max-content;
  }

  .services-pin__num {
    font-family: var(--font-display);
    font-size: var(--text-service-num);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0;
    color: var(--color-text-primary);
    width: max-content;
  }

  .services-pin__copy {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    padding-top: var(--service-copy-top);
    max-width: var(--service-copy-w);
  }

  .services-pin__copy h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-service-name);
    font-weight: 600;
    line-height: normal;
    color: var(--color-text-primary);
  }

  .services-pin__copy p {
    margin: 0;
    max-width: var(--service-copy-w);
    font-family: var(--font-body);
    font-size: var(--text-service-desc);
    font-weight: 400;
    line-height: normal;
    color: #e9e9e9;
  }

  :global([data-theme='light']) .services-pin__copy p {
    color: var(--color-text-secondary);
  }

  /* Visual group 570×388.42 — media behind folder (Figma 11:76) */
  .services-pin__visual {
    position: relative;
    width: 556px;
    height: 388.422px;
    margin-top: 50px;
    justify-self: start;
    container-type: inline-size;
  }

  .services-pin__media {
    position: absolute;
    left: 13px;
    top: 49px;
    z-index: 1;
    width: 543px;
    height: 331px;
    border: 1.8cqw solid var(--color-surface);
    border-radius: 5.76cqw;
    overflow: hidden;
    box-sizing: border-box;
    background: var(--color-service-panel-fill);
  }

  .services-pin__media img {
    position: absolute;
    left: 55.64%;
    right: 0;
    top: 0;
    bottom: 0;
    display: block;
    /* Ocupa solo la franja visible a la derecha de la carpeta */
    width: 44.36%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    /* Zoom sobre la pantalla del mockup; el marco recorta por overflow */
    transform: scale(var(--service-media-zoom));
    transform-origin: center center;
  }

  .services-pin__folder {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 2;
    width: var(--service-folder-w);
    height: var(--service-folder-h);
    pointer-events: none;
  }

  .services-pin__folder-shape {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
    overflow: visible;
  }

  .services-pin__folder-fill {
    fill: var(--color-service-panel-fill);
    stroke: var(--color-border);
    stroke-width: 1;
  }

  :global([data-theme='light']) .services-pin__folder {
    filter: drop-shadow(0 12px 28px rgba(9, 9, 11, 0.08));
  }

  .services-pin__list {
    position: absolute;
    left: 6.05%;
    top: 15.2%;
    z-index: 1;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 3.42cqw;
    margin: 0;
    padding: 0;
    width: max-content;
    max-width: calc(100% - 38px);
  }

  .services-pin__list li {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(14px, 4.317cqw, 24px);
    font-weight: 400;
    line-height: 1.29;
    color: #e9e9e9;
    white-space: nowrap;
  }

  :global([data-theme='light']) .services-pin__list li {
    color: var(--color-text-primary);
  }

  .services-pin__progress {
    display: none;
  }

  @media (max-width: 1180px) {
    .services-pin__stage {
      width: min(100% - var(--margin) * 2, 1082px);
    }

    .services-pin__panel {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: clamp(24px, 4vw, 56px);
    }

    .services-pin__intro {
      grid-template-columns: max-content minmax(0, var(--service-copy-w));
      column-gap: var(--service-num-to-copy-gap);
      width: auto;
    }

    .services-pin__num {
      font-size: clamp(4.5rem, 12vw, 128px);
    }

    .services-pin__visual {
      width: 100%;
      max-width: 556px;
      height: auto;
      aspect-ratio: 556 / 388.422;
      margin-top: clamp(24px, 3vw, 50px);
    }

    .services-pin__folder {
      width: 56.47%;
      height: 100%;
    }

    .services-pin__media {
      left: 2.34%;
      top: 12.61%;
      width: 97.66%;
      height: 85.22%;
    }

    .services-pin__list {
      left: 6.05%;
      top: 15.2%;
    }
  }

  @media (max-width: 900px) {
    .services-pin__sticky {
      min-height: auto;
    }

    .services-pin__fit {
      padding-block: clamp(64px, 12vw, 96px);
      gap: 28px;
    }

    .services-pin__panel {
      position: relative;
      opacity: 1;
      visibility: visible;
      transform: none;
      pointer-events: auto;
      display: none;
      grid-template-columns: 1fr;
      gap: 20px;
      column-gap: 0;
    }

    .services-pin__panel.is-active {
      display: grid;
    }

    .services-pin__stage {
      min-height: auto;
      width: min(100% - var(--margin) * 2, 1280px);
      overflow: hidden;
    }

    .services-pin__intro {
      grid-template-columns: auto 1fr;
      gap: 16px;
      width: auto;
    }

    .services-pin__copy {
      padding-top: 8px;
      max-width: none;
    }

    .services-pin__copy p {
      max-width: none;
    }

    .services-pin__visual {
      width: min(100%, 556px);
      max-width: 556px;
      height: auto;
      aspect-ratio: 556 / 388.422;
      margin-top: 0;
      justify-self: center;
    }

    .services-pin__folder {
      width: 56.47%;
      height: 100%;
    }

    .services-pin__list {
      position: absolute;
      left: 6.05%;
      top: 15.2%;
    }

    .services-pin__media {
      left: 2.34%;
      top: 12.61%;
      width: 97.66%;
      height: 85.22%;
    }

    .services-pin__progress {
      display: flex;
      justify-content: center;
      gap: 8px;
    }

    .services-pin__tick {
      position: relative;
      width: 28px;
      height: 4px;
      padding: 0;
      border: 0;
      border-radius: 999px;
      background: color-mix(in srgb, var(--color-text-primary) 18%, transparent);
      cursor: pointer;
    }

    .services-pin__tick::after {
      content: '';
      position: absolute;
      inset: -18px -6px;
    }

    .services-pin__tick.is-active {
      background: var(--color-primary);
    }
  }

  /*
   * Laptops de poca altura (≤840px): el padding de .services-pin__fit depende
   * del ancho (8vw), no de la altura, así que en pantallas anchas y bajas la
   * card queda pegada al borde inferior. Escalamos la composición completa
   * según la altura para que quede centrada con aire arriba y abajo.
   */
  @media (min-width: 901px) and (max-height: 840px) {
    .services-pin__fit {
      zoom: 0.9;
    }
  }

  @media (min-width: 901px) and (max-height: 780px) {
    .services-pin__fit {
      zoom: 0.85;
    }
  }

  @media (min-width: 901px) and (max-height: 720px) {
    .services-pin__fit {
      zoom: 0.8;
    }
  }

  @media (min-width: 901px) and (max-height: 660px) {
    .services-pin__fit {
      zoom: 0.72;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .services-pin__panel {
      transition: none;
    }
  }
</style>
